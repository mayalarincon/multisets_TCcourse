%%-------------------------------------------------------------------------
%% Theory multisetsN
%%
%% Finite multisets over the natural numbers and the multiset ordering
%% (Dershowitz-Manna). It includes:
%%  - multisets as functions nat -> nat, with union, intersection,
%%    difference, membership and inclusion, and their basic properties;
%%  - finite multisets, their domain, and the counting functions
%%    occurrences and card_msN;
%%  - the multiset ordering msN_gt?, written infix as m >> n, and its
%%    one-step version msN_gt_one?, with >> = TC(msN_gt_one?);
%%  - properties of >>, following Lemma 7.3.11 of the book by
%%    Ayala-Rincón and de Moura (see References): irreflexivity,
%%    transitivity, the reflexive closure is a total order, singleton
%%    characterization and monotonicity w.r.t. union;
%%  - termination: msN_gt_one? and >> are noetherian, proved through
%%    an inductive accessibility predicate (msN_acc?), hence
%%    well_founded?(converse(>>)).
%%
%% References:
%%  - N. Dershowitz and Z. Manna. Proving termination with multiset
%%    orderings. Communications of the ACM, 22(8):465-476, 1979.
%%  - F. Baader and T. Nipkow. Term Rewriting and All That.
%%    Cambridge University Press, 1998.
%%  - M. Ayala-Rincón and F. L. C. de Moura. Princípios da Programação
%%    Lógica e Funcional: o princípio de resolução e a teoria de
%%    reescrita. EdUnB, 2014.
%%
%% Date      : October 12, 2026
%% Authors   : Mauricio Ayala-Rincón, IME/UFG
%% Students  : Arthur Trindade da Silva (Ciência da Computação/UFG)
%%             Brian Matheus Rodrigues Ribeiro (Ciência da Computação/UFG)
%%             Magno Martins da Silva (Matemática/UFG)
%%-------------------------------------------------------------------------

multisetsN : THEORY
BEGIN

% comment

  multisetN: TYPE = [nat -> nat]

  m, n, p: VAR multisetN
  x, y: VAR nat

  empty_msN: multisetN = (LAMBDA x: 0)

  count_msN(m)(x): nat = m(x)

  add_msN(x, m): multisetN = m WITH [(x) := m(x) + 1]

  union_msN(m, n): multisetN = (LAMBDA x: m(x) + n(x))

  intersection_msN(m, n): multisetN = (LAMBDA x: min(m(x), n(x)))

  difference_msN(m, n): multisetN = (LAMBDA x: IF m(x) > n(x) THEN m(x) - n(x) ELSE 0 ENDIF)

  member_msN?(x, m): bool = m(x) > 0

  subset_msN?(m, n): bool = FORALL x: m(x) <= n(x)

  % @QED union_msN_empty_msN_left proved by arthur on Fri, 18 Sep 2026 14:17:21 GMT
  union_msN_empty_msN_left: LEMMA FORALL m: union_msN(empty_msN, m) = m

  % @QED union_msN_empty_msN_right proved by arthur on Fri, 18 Sep 2026 14:17:45 GMT
  union_msN_empty_msN_right: LEMMA FORALL m: union_msN(m, empty_msN) = m

  % @QED intersection_msN_empty_msN_left proved by arthur on Fri, 18 Sep 2026 14:18:21 GMT
  intersection_msN_empty_msN_left: LEMMA FORALL m: intersection_msN(empty_msN, m) = empty_msN

  % @QED intersection_msN_empty_msN_right proved by arthur on Fri, 18 Sep 2026 14:18:47 GMT
  intersection_msN_empty_msN_right: LEMMA FORALL m: intersection_msN(m, empty_msN) = empty_msN

  % @QED difference_msN_empty_msN_left proved by arthur on Fri, 18 Sep 2026 14:19:11 GMT
  difference_msN_empty_msN_left: LEMMA FORALL m: difference_msN(empty_msN, m) = empty_msN

  % @QED difference_msN_empty_msN_right proved by arthur on Fri, 18 Sep 2026 14:22:09 GMT
  difference_msN_empty_msN_right: LEMMA FORALL m: difference_msN(m, empty_msN) = m

  % @QED difference_msN_m_m_empty_msN proved by arthur on Mon, 21 Sep 2026 17:17:47 GMT
  difference_msN_m_m_empty_msN: LEMMA FORALL m: difference_msN(m, m) = empty_msN

  % @QED union_msN_comm proved by arthur on Fri, 18 Sep 2026 14:22:29 GMT
  union_msN_comm: LEMMA
    FORALL m, n: union_msN(m, n) = union_msN(n, m)

  union_msN_assoc: LEMMA
    FORALL m, n, p: union_msN(m, union_msN(n, p)) = union_msN(union_msN(m, n), p)

  % @QED intersection_msN_comm proved by arthur on Fri, 18 Sep 2026 14:23:57 GMT
  intersection_msN_comm: LEMMA
    FORALL m, n: intersection_msN(m, n) = intersection_msN(n, m)

  % @QED intersection_msN_assoc proved by arthur on Fri, 18 Sep 2026 14:24:48 GMT
  intersection_msN_assoc: LEMMA
    FORALL m, n, p: intersection_msN(m, intersection_msN(n, p)) = intersection_msN(intersection_msN(m, n), p)

  % @QED subset_msN_transitive proved by arthur on Fri, 18 Sep 2026 14:25:27 GMT
  subset_msN_transitive: LEMMA
   FORALL m, n, p: subset_msN?(m,n) AND subset_msN?(n,p) IMPLIES  subset_msN?(m,p)
   
  % @QED subset_msN_union_msN proved by arthur on Fri, 18 Sep 2026 14:25:56 GMT
  subset_msN_union_msN:  LEMMA
    FORALL m, n: subset_msN?(m, union_msN(m,n))

  % @QED subset_msN_intersection_msN proved by arthur on Fri, 18 Sep 2026 14:25:44 GMT
  subset_msN_intersection_msN:  LEMMA
    FORALL m, n: subset_msN?(intersection_msN(m,n), m)

  % @QED subset_msN_difference_msN proved by arthur on Fri, 18 Sep 2026 14:26:07 GMT
  subset_msN_difference_msN: LEMMA
    FORALL m, n: subset_msN?(difference_msN(m,n), m)
  subset_msN_m_m : LEMMA
    FORALL m : subset_msN?(m,m)


  % Baader & Nipkow multiset ordering
  % M >> N iff there exist X, Y such that X is non-empty sub-multiset of M,
  % N = (M - X) + Y, and for all y in Y, there is an x in X such that y < x.

  % To formalize this, we might need to define finite multisets first, 
  % as the standard definition often assumes finiteness.
  % A multiset is finite if the set of elements with count > 0 is finite.

  is_finite?(m): bool = EXISTS (S: set[nat]): is_finite(S) AND (FORALL x: m(x) > 0 => member(x, S))

  finite_multisetN: TYPE = (is_finite?)

  % TRS@noetherian also imports TRS@relations_closure (TC, RC, RTC)
  IMPORTING TRS@noetherian[finite_multisetN]
  

  % @QED empty_msN_is_finite proved by arthur on Fri, 18 Sep 2026 14:52:17 GMT
  empty_msN_is_finite: LEMMA is_finite?(empty_msN)

  domain(m: finite_multisetN): finite_set[nat] = { n: nat | m(n) > 0 }

  singleton_msN(x: nat): finite_multisetN = (LAMBDA y: IF x = y THEN 1 ELSE 0 ENDIF)

  is_singleton?(m: finite_multisetN): bool = EXISTS x: m = singleton_msN(x)

   % @QED union_msN_fin_msN_is_fin_msN proved by arthur on Fri, 18 Sep 2026 14:54:43 GMT
   union_msN_fin_msN_is_fin_msN: LEMMA FORALL(m,n: finite_multisetN) : is_finite?(union_msN(m,n))

   intersection_msN_fin_msN_is_fin_msN: LEMMA FORALL(m,n: finite_multisetN): is_finite?(intersection_msN(m,n))
  % refined version
   intersection_msN_with_fin_msN_is_fin_msN: LEMMA FORALL(m: finite_multisetN, n: multisetN): is_finite?(intersection_msN(m,n))

   subset_msN_fin_msN_is_fin_msN: LEMMA FORALL(m: multisetN ,n: finite_multisetN): subset_msN?(m,n) IMPLIES is_finite?(m)
    
   difference_msN_fin_msN_is_fin_msN: LEMMA FORALL(m: finite_multisetN, n:multisetN): is_finite?(difference_msN(m,n))

  singleton_w_rep(x: nat, n: nat): finite_multisetN = (LAMBDA y: IF x = y THEN n ELSE 0 ENDIF)

  is_single_element?(m: finite_multisetN): bool = EXISTS (x: nat, n: nat): m = singleton_w_rep(x, n)

  subset_msN_subset_dom : LEMMA
    FORALL (m, n: finite_multisetN): subset_msN?(m,n) IMPLIES subset?(domain(m),domain(n))

  subset_msN_subset_msN_diff_singl : LEMMA FORALL(m:finite_multisetN | NOT m = empty_msN) :
                                 LET a = choose(domain(m)) IN
                                   subset_msN?(difference_msN(m,singleton_w_rep(a, m(a))), m) AND
				   subset_msN?(difference_msN(m,singleton_msN(a)), m)

  % Removing every copy of a from m removes exactly a from the domain.
  dom_diff_w_rep : LEMMA FORALL (m: finite_multisetN, a: nat):
    domain(difference_msN(m, singleton_w_rep(a, m(a)))) = remove(a, domain(m))

  card_dom_diff_w_rep : LEMMA FORALL (m: finite_multisetN, a: nat): m(a) > 0 IMPLIES
    card(domain(difference_msN(m, singleton_w_rep(a, m(a))))) = card(domain(m)) - 1

 occurrences(m:finite_multisetN) : RECURSIVE nat =
      IF m = empty_msN THEN 0
      ELSE LET a = choose(domain(m)),
               mp = difference_msN(m,singleton_w_rep(a, m(a))) IN
	   m(a) + occurrences(mp)
      ENDIF
  MEASURE card(domain(m))

  % occurrences does not depend on which element is removed first.
  occ_remove_any : LEMMA FORALL (m: finite_multisetN, a: nat): m(a) > 0 IMPLIES
    occurrences(m) = m(a) + occurrences(difference_msN(m, singleton_w_rep(a, m(a))))

  occ_remove_one : LEMMA FORALL (m: finite_multisetN, a: nat): m(a) > 0 IMPLIES
    occurrences(m) = 1 + occurrences(difference_msN(m, singleton_msN(a)))

  occ_zero_empty_msN : LEMMA FORALL (m: finite_multisetN):
    occurrences(m) = 0 IMPLIES m = empty_msN

  occ_union_msN : LEMMA FORALL (m, n: finite_multisetN):
    occurrences(union_msN(m, n)) = occurrences(m) + occurrences(n)

card_msN(m:finite_multisetN) : RECURSIVE nat =
      IF m = empty_msN THEN 0
      ELSE LET a = choose(domain(m)),
               mp = difference_msN(m,singleton_msN(a)) IN
	   1 + card_msN(mp)
      ENDIF
  MEASURE occurrences(m)

  occ_eq_card_msN : LEMMA FORALL(m: finite_multisetN) : occurrences(m) = card_msN(m)                       

  card_empty_msN : LEMMA card_msN(empty_msN) = 0
 
  card_singleton_msN : LEMMA card_msN(singleton_msN(x)) = 1

  card_msN_one_char : LEMMA
    FORALL (m: finite_multisetN): card_msN(m) = 1 IFF is_singleton?(m)

  card_singleton_w_rep : LEMMA card_msN(singleton_w_rep(x,y)) = y

  card_union_msN : LEMMA
    FORALL (m, n: finite_multisetN): card_msN(union_msN(m,n)) = card_msN(m) + card_msN(n)

  card_difference_msN : LEMMA
    FORALL (m, n: finite_multisetN):
      card_msN(difference_msN(m,n)) = card_msN(m) - card_msN(intersection_msN(m,n))
 

  singleton_w_rep_1: LEMMA
    FORALL (x: nat): singleton_w_rep(x, 1) = singleton_msN(x)

  union_msN_singleton_w_rep: LEMMA
    FORALL (x: nat, n, m: nat):
      union_msN(singleton_w_rep(x, n), singleton_w_rep(x, m)) = singleton_w_rep(x, n + m)

  difference_msN_singleton_w_rep: LEMMA
    FORALL (x: nat, n, m: nat):
      n >= m =>
        difference_msN(singleton_w_rep(x, n), singleton_w_rep(x, m)) = singleton_w_rep(x, n - m)

  difference_msN_singleton_w_rep_empty_msN: LEMMA
    FORALL (x: nat, n, m: nat):
      n < m =>
        difference_msN(singleton_w_rep(x, n), singleton_w_rep(x, m)) = empty_msN

  % @QED subset_msN_singleton proved by arthur on Mon, 21 Sep 2026 17:30:37 GMT
  subset_msN_singleton : LEMMA subset_msN?(m, singleton_msN(x)) IFF m = empty_msN or m = singleton_msN(x)

  subset_msN_singleton_w_rep: LEMMA
    FORALL (m: finite_multisetN, x: nat, n: nat):
      subset_msN?(m, singleton_w_rep(x, n)) => m = singleton_w_rep(x, m(x)) AND m(x) <= n

  % Multiset ordering definition
  msN_gt?(m, n: finite_multisetN): bool = 
    EXISTS (X, Y: finite_multisetN):
      subset_msN?(X, m) AND NOT X = empty_msN AND
      n = union_msN(difference_msN(m, X), Y) AND
      (FORALL y: member_msN?(y, Y) => EXISTS x: member_msN?(x, X) AND y < x);

  % Infix notation: m >> n means that n is below m in the multiset ordering
  >>: MACRO pred[[finite_multisetN, finite_multisetN]] = msN_gt?

% One-step Multiset ordering definition
  msN_gt_one?(m, n: finite_multisetN): bool =
    EXISTS (x: nat, Y: finite_multisetN):
      member_msN?(x, m) AND
      n = union_msN(difference_msN(m, singleton_msN(x)), Y) AND
      (FORALL y: member_msN?(y, Y) => y < x)

  msN_gt_one_subset_msN_gt: LEMMA 
    subset?(msN_gt_one?, >>)

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
%% ITEM (a)
  % @QED msN_gt_one_subset_tc proved by arthur on Mon, 21 Sep 2026 17:32:04 GMT
  msN_gt_one_subset_tc: LEMMA
    subset?(TC(msN_gt_one?), >>)

  % Split Y into the elements below a and the rest.
  msN_below(Y: finite_multisetN, a: nat): finite_multisetN =
    LAMBDA (z: nat): IF z < a THEN Y(z) ELSE 0 ENDIF

  msN_above(Y: finite_multisetN, a: nat): finite_multisetN =
    LAMBDA (z: nat): IF z < a THEN 0 ELSE Y(z) ENDIF

  % Removing one copy of a and adding the elements of Y below a is one step.
  msN_gt_one_step : LEMMA
    FORALL (A, Y: finite_multisetN, a: nat): A(a) > 0 IMPLIES
      msN_gt_one?(A, union_msN(difference_msN(A, singleton_msN(a)), msN_below(Y, a)))

  msN_split_eq : LEMMA
    FORALL (X, A, Y: finite_multisetN, a: nat): subset_msN?(X, A) AND X(a) > 0 IMPLIES
      union_msN(difference_msN(A, X), Y) =
        union_msN(difference_msN(union_msN(difference_msN(A, singleton_msN(a)), msN_below(Y, a)),
                         difference_msN(X, singleton_msN(a))),
              msN_above(Y, a))

  msN_split_subset_msN : LEMMA
    FORALL (X, A, Y: finite_multisetN, a: nat): subset_msN?(X, A) AND X(a) > 0 IMPLIES
      subset_msN?(difference_msN(X, singleton_msN(a)),
             union_msN(difference_msN(A, singleton_msN(a)), msN_below(Y, a)))

  msN_split_dom : LEMMA
    FORALL (X, Y: finite_multisetN, a: nat):
      (FORALL y: member_msN?(y, Y) => EXISTS x: member_msN?(x, X) AND y < x) IMPLIES
      (FORALL y: member_msN?(y, msN_above(Y, a)) =>
         EXISTS x: member_msN?(x, difference_msN(X, singleton_msN(a))) AND y < x)

  msN_split_dom_empty_msN : LEMMA
    FORALL (X, Y: finite_multisetN, a: nat):
      (FORALL y: member_msN?(y, Y) => EXISTS x: member_msN?(x, X) AND y < x) AND
      difference_msN(X, singleton_msN(a)) = empty_msN IMPLIES msN_above(Y, a) = empty_msN

  % Generalisation of msN_gt_subset_msN_gt_one_tc, by induction on X.
  msN_gt_tc_aux : LEMMA
    FORALL (X, A, B, Y: finite_multisetN):
      NOT X = empty_msN AND subset_msN?(X, A) AND B = union_msN(difference_msN(A, X), Y) AND
      (FORALL y: member_msN?(y, Y) => EXISTS x: member_msN?(x, X) AND y < x)
      IMPLIES TC(msN_gt_one?)(A, B)

  msN_gt_subset_msN_gt_one_tc : COROLLARY
    subset?(>>, TC(msN_gt_one?))

  msN_gt_equal_msN_gt_one_tc : COROLLARY
    >> = TC(msN_gt_one?)

  msN_gt_transitive : LEMMA
     transitive?(>>)

  msN_gt_tc_equivalence: LEMMA
    subset?(TC(msN_gt_one?), TC(>>))

  msN_gt_one_subset_rtc: LEMMA
    subset?(RTC(msN_gt_one?), RC(>>))


  % max of a finite set of naturals, used in msN_gt_irreflexive
  IMPORTING finite_sets@finite_sets_minmax[nat, <=]

  msN_gt_irreflexive: LEMMA
    FORALL (m: finite_multisetN):
      NOT m >> m


%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
% ITEM (B)
msN_gt_U_eq_poset: LEMMA partial_order?(RC(>>)) 

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
%  ITEM (c)
  msN_gt_singleton_iff_lt: LEMMA
    x > y IFF singleton_msN(x) >> singleton_msN(y) 

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
% ITEM (d)

 msN_gt_union_msN_monotone : LEMMA
   FORALL(m,n,p:finite_multisetN) :
     m >> n IMPLIES union_msN(m,p) >> union_msN(n,p)

  % If m exceeds n at a, and they agree on every element above a,
  % then m is above n in the multiset ordering (used in msN_gt_total_order)
  msN_gt_max_diff: LEMMA
    FORALL (m, n: finite_multisetN, a: nat):
      m(a) > n(a) AND (FORALL y: y > a => m(y) = n(y)) IMPLIES m >> n

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
%% ITEM (e)
%% Indeed, this lemma, for a well-order geq over 
%% and non-interpreted type is an implication:
%% total_order?(geq) IMPLIES total_order?(>>)
 msN_gt_total_order : LEMMA 
     total_order?(RC(>>)) 
   

  msN_gt_empty_msN: LEMMA
    FORALL (m: finite_multisetN):
      NOT m = empty_msN => m >> empty_msN


  % Termination of the multiset ordering.
  % m >> n means that n is below m (>> is a reduction relation),
  % so well-foundedness is stated for its converse: noetherian?(R) is
  % defined in TRS@noetherian as well_founded?(converse(R)).

  % Accessible part of msN_gt_one?: M is accessible when all its one-step
  % successors are. Accessible elements start no infinite msN_gt_one? chain.
  msN_acc?(M: finite_multisetN): INDUCTIVE bool =
    FORALL (N: finite_multisetN): msN_gt_one?(M, N) IMPLIES msN_acc?(N)

  % If every finite multiset is accessible, msN_gt_one? is noetherian.
  msN_acc_noetherian: LEMMA
    (FORALL (M: finite_multisetN): msN_acc?(M)) IMPLIES noetherian?(msN_gt_one?)

  % Equations on multisets used in the accessibility proof
  union_msN_singl_diff: LEMMA
    FORALL (M, Y: finite_multisetN, a: nat):
      union_msN(difference_msN(union_msN(M, singleton_msN(a)), singleton_msN(a)), Y) = union_msN(M, Y)

  union_msN_singl_diff_neq: LEMMA
    FORALL (M, Y: finite_multisetN, a, b: nat): b /= a IMPLIES
      union_msN(difference_msN(union_msN(M, singleton_msN(a)), singleton_msN(b)), Y) =
        union_msN(union_msN(difference_msN(M, singleton_msN(b)), Y), singleton_msN(a))

  union_msN_split_one: LEMMA
    FORALL (M, Y: finite_multisetN, b: nat): Y(b) > 0 IMPLIES
      union_msN(M, Y) = union_msN(union_msN(M, difference_msN(Y, singleton_msN(b))), singleton_msN(b))

  % Adding elements below a preserves accessibility, provided that adding
  % a single element below a does (induction on the occurrences of Y).
  msN_acc_add_below: LEMMA
    FORALL (a: nat):
      (FORALL (b: nat, M: finite_multisetN):
         b < a AND msN_acc?(M) IMPLIES msN_acc?(union_msN(M, singleton_msN(b))))
      IMPLIES
      FORALL (Y, M: finite_multisetN):
        (FORALL y: member_msN?(y, Y) => y < a) AND msN_acc?(M) IMPLIES msN_acc?(union_msN(M, Y))

  % Adding one element preserves accessibility (strong induction on a,
  % then induction on the accessibility of M).
  msN_acc_add: LEMMA
    FORALL (a: nat, M: finite_multisetN):
      msN_acc?(M) IMPLIES msN_acc?(union_msN(M, singleton_msN(a)))

  msN_acc_all: LEMMA
    FORALL (M: finite_multisetN): msN_acc?(M)

  msN_gt_one_noetherian: LEMMA
    noetherian?(msN_gt_one?)

  % Uses >> = TC(msN_gt_one?) and the library lemma R_is_Noet_iff_TC_is
  msN_gt_noetherian: LEMMA
    noetherian?(>>)

  msN_gt_well_founded: COROLLARY
    well_founded?[finite_multisetN](converse(>>))

END multisetsN
