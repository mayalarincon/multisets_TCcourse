%%-------------------------------------------------------------------------
%% Theory multisets_nat
%%
%% Finite multisets over the natural numbers and the multiset ordering
%% (Dershowitz-Manna). It includes:
%%  - multisets as functions nat -> nat, with union, intersection,
%%    difference, membership and inclusion, and their basic properties;
%%  - finite multisets, their domain, and the counting functions
%%    occurrences and card_ms;
%%  - the multiset ordering ms_ord and its one-step version ms_ord_one,
%%    with ms_ord = TC(ms_ord_one);
%%  - properties of ms_ord, following Lemma 7.3.11 of the book by
%%    Ayala-Rincón and de Moura (see References): irreflexivity,
%%    transitivity, the reflexive closure is a total order, singleton
%%    characterization and monotonicity w.r.t. union;
%%  - termination: ms_ord_one and ms_ord are noetherian, proved through
%%    an inductive accessibility predicate (ms_acc), hence
%%    well_founded?(converse(ms_ord)).
%%
%% References:
%%  - N. Dershowitz and Z. Manna. Proving termination with multiset
%%    orderings. Communications of the ACM, 22(8):465-476, 1979.
%%  - F. Baader and T. Nipkow. Term Rewriting and All That.
%%    Cambridge University Press, 1998.
%%  - M. Ayala-Rincón and F. L. C. de Moura. Princípios da Programação
%%    Lógica e Funcional: o princípio de resolução e a teoria de
%%    reescrita. EdUnB, 2014.
%%
%% Date    : October 12, 2026
%% Author  : Mauricio Ayala-Rincón, IME/UFG
%% Students: Arthur Trindade da Silva (Ciência da Computação/UFG)
%%           Brian Matheus Rodrigues Ribeiro (Ciência da Computação/UFG)
%%           Magno Martins da Silva (Matemática/UFG)
%%-------------------------------------------------------------------------

multisets_nat : THEORY
BEGIN

% comment

  multiset: TYPE = [nat -> nat]

  m, n, p: VAR multiset
  x, y: VAR nat

  empty: multiset = (LAMBDA x: 0)

  count(m)(x): nat = m(x)

  add(x, m): multiset = m WITH [(x) := m(x) + 1]

  union(m, n): multiset = (LAMBDA x: m(x) + n(x))

  intersection(m, n): multiset = (LAMBDA x: min(m(x), n(x)))

  difference(m, n): multiset = (LAMBDA x: IF m(x) > n(x) THEN m(x) - n(x) ELSE 0 ENDIF)

  member(x, m): bool = m(x) > 0

  subset(m, n): bool = FORALL x: m(x) <= n(x)

  % @QED union_empty_left proved by arthur on Fri, 18 Sep 2026 14:17:21 GMT
  union_empty_left: LEMMA FORALL m: union(empty, m) = m

  % @QED union_empty_right proved by arthur on Fri, 18 Sep 2026 14:17:45 GMT
  union_empty_right: LEMMA FORALL m: union(m, empty) = m

  % @QED intersection_empty_left proved by arthur on Fri, 18 Sep 2026 14:18:21 GMT
  intersection_empty_left: LEMMA FORALL m: intersection(empty, m) = empty

  % @QED intersection_empty_right proved by arthur on Fri, 18 Sep 2026 14:18:47 GMT
  intersection_empty_right: LEMMA FORALL m: intersection(m, empty) = empty

  % @QED difference_empty_left proved by arthur on Fri, 18 Sep 2026 14:19:11 GMT
  difference_empty_left: LEMMA FORALL m: difference(empty, m) = empty

  % @QED difference_empty_right proved by arthur on Fri, 18 Sep 2026 14:22:09 GMT
  difference_empty_right: LEMMA FORALL m: difference(m, empty) = m

  % @QED difference_m_m_empty proved by arthur on Mon, 21 Sep 2026 17:17:47 GMT
  difference_m_m_empty: LEMMA FORALL m: difference(m, m) = empty

  % @QED union_comm proved by arthur on Fri, 18 Sep 2026 14:22:29 GMT
  union_comm: LEMMA
    FORALL m, n: union(m, n) = union(n, m)

  union_assoc: LEMMA
    FORALL m, n, p: union(m, union(n, p)) = union(union(m, n), p)

  % @QED intersection_comm proved by arthur on Fri, 18 Sep 2026 14:23:57 GMT
  intersection_comm: LEMMA
    FORALL m, n: intersection(m, n) = intersection(n, m)

  % @QED intersection_assoc proved by arthur on Fri, 18 Sep 2026 14:24:48 GMT
  intersection_assoc: LEMMA
    FORALL m, n, p: intersection(m, intersection(n, p)) = intersection(intersection(m, n), p)

  % @QED subset_transitive proved by arthur on Fri, 18 Sep 2026 14:25:27 GMT
  subset_transitive: LEMMA
   FORALL m, n, p: subset(m,n) AND subset(n,p) IMPLIES  subset(m,p)
   
  % @QED subset_union proved by arthur on Fri, 18 Sep 2026 14:25:56 GMT
  subset_union:  LEMMA
    FORALL m, n: subset(m, union(m,n))

  % @QED subset_intersection proved by arthur on Fri, 18 Sep 2026 14:25:44 GMT
  subset_intersection:  LEMMA
    FORALL m, n: subset(intersection(m,n), m)

  % @QED subset_difference proved by arthur on Fri, 18 Sep 2026 14:26:07 GMT
  subset_difference: LEMMA
    FORALL m, n: subset(difference(m,n), m)
  subset_m_m : LEMMA
    FORALL m : subset(m,m)


  % Baader & Nipkow multiset ordering
  % M >> N iff there exist X, Y such that X is non-empty sub-multiset of M,
  % N = (M - X) + Y, and for all y in Y, there is an x in X such that y < x.

  % To formalize this, we might need to define finite multisets first, 
  % as the standard definition often assumes finiteness.
  % A multiset is finite if the set of elements with count > 0 is finite.

  is_finite(m): bool = EXISTS (S: set[nat]): is_finite(S) AND (FORALL x: m(x) > 0 => member(x, S))

  finite_multiset: TYPE = (is_finite)

  % TRS@noetherian also imports TRS@relations_closure (TC, RC, RTC)
  IMPORTING TRS@noetherian[finite_multiset]
  

  % @QED empty_is_finite proved by arthur on Fri, 18 Sep 2026 14:52:17 GMT
  empty_is_finite: LEMMA is_finite(empty)

  domain(m: finite_multiset): finite_set[nat] = { n: nat | m(n) > 0 }

  singleton_ms(x: nat): finite_multiset = (LAMBDA y: IF x = y THEN 1 ELSE 0 ENDIF)

  is_singleton(m: finite_multiset): bool = EXISTS x: m = singleton_ms(x)

   % @QED union_fin_ms_is_fin_ms proved by arthur on Fri, 18 Sep 2026 14:54:43 GMT
   union_fin_ms_is_fin_ms: LEMMA FORALL(m,n: finite_multiset) : is_finite(union(m,n))

   intersection_fin_ms_is_fin_ms: LEMMA FORALL(m,n: finite_multiset): is_finite(intersection(m,n))
  % refined version
   intersection_with_fin_ms_is_fin_ms: LEMMA FORALL(m: finite_multiset, n: multiset): is_finite(intersection(m,n))

   subset_fin_ms_is_fin_ms: LEMMA FORALL(m: multiset ,n: finite_multiset): subset(m,n) IMPLIES is_finite(m)
    
   difference_fin_ms_is_fin_ms: LEMMA FORALL(m: finite_multiset, n:multiset): is_finite(difference(m,n))

  singleton_w_rep(x: nat, n: nat): finite_multiset = (LAMBDA y: IF x = y THEN n ELSE 0 ENDIF)

  is_single_element(m: finite_multiset): bool = EXISTS (x: nat, n: nat): m = singleton_w_rep(x, n)

  subset_ms_subset_dom : LEMMA
    FORALL (m, n: finite_multiset): subset(m,n) IMPLIES subset?(domain(m),domain(n))

  subset_ms_subset_diff_singl : LEMMA FORALL(m:finite_multiset | NOT m = empty) :
                                 LET a = choose(domain(m)) IN
                                   subset(difference(m,singleton_w_rep(a, m(a))), m) AND
				   subset(difference(m,singleton_ms(a)), m)

  % Removing every copy of a from m removes exactly a from the domain.
  dom_diff_w_rep : LEMMA FORALL (m: finite_multiset, a: nat):
    domain(difference(m, singleton_w_rep(a, m(a)))) = remove(a, domain(m))

  card_dom_diff_w_rep : LEMMA FORALL (m: finite_multiset, a: nat): m(a) > 0 IMPLIES
    card(domain(difference(m, singleton_w_rep(a, m(a))))) = card(domain(m)) - 1

 occurrences(m:finite_multiset) : RECURSIVE nat =
      IF m = empty THEN 0
      ELSE LET a = choose(domain(m)),
               mp = difference(m,singleton_w_rep(a, m(a))) IN
	   m(a) + occurrences(mp)
      ENDIF
  MEASURE card(domain(m))

  % occurrences does not depend on which element is removed first.
  occ_remove_any : LEMMA FORALL (m: finite_multiset, a: nat): m(a) > 0 IMPLIES
    occurrences(m) = m(a) + occurrences(difference(m, singleton_w_rep(a, m(a))))

  occ_remove_one : LEMMA FORALL (m: finite_multiset, a: nat): m(a) > 0 IMPLIES
    occurrences(m) = 1 + occurrences(difference(m, singleton_ms(a)))

  occ_zero_empty : LEMMA FORALL (m: finite_multiset):
    occurrences(m) = 0 IMPLIES m = empty

  occ_union : LEMMA FORALL (m, n: finite_multiset):
    occurrences(union(m, n)) = occurrences(m) + occurrences(n)

card_ms(m:finite_multiset) : RECURSIVE nat =
      IF m = empty THEN 0
      ELSE LET a = choose(domain(m)),
               mp = difference(m,singleton_ms(a)) IN
	   1 + card_ms(mp)
      ENDIF
  MEASURE occurrences(m)

  occ_eq_card_ms : LEMMA FORALL(m: finite_multiset) : occurrences(m) = card_ms(m)                       

  card_empty_ms : LEMMA card_ms(empty) = 0
 
  card_singleton_ms : LEMMA card_ms(singleton_ms(x)) = 1

  card_ms_one_char : LEMMA
    FORALL (m: finite_multiset): card_ms(m) = 1 IFF is_singleton(m)

  card_singleton_w_rep : LEMMA card_ms(singleton_w_rep(x,y)) = y

  card_union_ms : LEMMA
    FORALL (m, n: finite_multiset): card_ms(union(m,n)) = card_ms(m) + card_ms(n)

  card_difference_ms : LEMMA
    FORALL (m, n: finite_multiset):
      card_ms(difference(m,n)) = card_ms(m) - card_ms(intersection(m,n))
 

  singleton_w_rep_1: LEMMA
    FORALL (x: nat): singleton_w_rep(x, 1) = singleton_ms(x)

  union_singleton_w_rep: LEMMA
    FORALL (x: nat, n, m: nat):
      union(singleton_w_rep(x, n), singleton_w_rep(x, m)) = singleton_w_rep(x, n + m)

  difference_singleton_w_rep: LEMMA
    FORALL (x: nat, n, m: nat):
      n >= m =>
        difference(singleton_w_rep(x, n), singleton_w_rep(x, m)) = singleton_w_rep(x, n - m)

  difference_singleton_w_rep_empty: LEMMA
    FORALL (x: nat, n, m: nat):
      n < m =>
        difference(singleton_w_rep(x, n), singleton_w_rep(x, m)) = empty

  % @QED subset_singleton proved by arthur on Mon, 21 Sep 2026 17:30:37 GMT
  subset_singleton : LEMMA subset(m, singleton_ms(x)) IFF m = empty or m = singleton_ms(x)

  subset_singleton_w_rep: LEMMA
    FORALL (m: finite_multiset, x: nat, n: nat):
      subset(m, singleton_w_rep(x, n)) => m = singleton_w_rep(x, m(x)) AND m(x) <= n

  % Multiset ordering definition
  ms_ord(m, n: finite_multiset): bool = 
    EXISTS (X, Y: finite_multiset):
      subset(X, m) AND NOT X = empty AND
      n = union(difference(m, X), Y) AND
      (FORALL y: member(y, Y) => EXISTS x: member(x, X) AND y < x)

% One-step Multiset ordering definition
  ms_ord_one(m, n: finite_multiset): bool =
    EXISTS (x: nat, Y: finite_multiset):
      member(x, m) AND
      n = union(difference(m, singleton_ms(x)), Y) AND
      (FORALL y: member(y, Y) => y < x)

  ms_ord_one_subset_ms_ord: LEMMA 
    subset?(ms_ord_one,  ms_ord)

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
%% ITEM (a)
  % @QED ms_ord_one_subset_tc proved by arthur on Mon, 21 Sep 2026 17:32:04 GMT
  ms_ord_one_subset_tc: LEMMA
    subset?(TC(ms_ord_one),  ms_ord)

  % Split Y into the elements below a and the rest.
  ms_below(Y: finite_multiset, a: nat): finite_multiset =
    LAMBDA (z: nat): IF z < a THEN Y(z) ELSE 0 ENDIF

  ms_above(Y: finite_multiset, a: nat): finite_multiset =
    LAMBDA (z: nat): IF z < a THEN 0 ELSE Y(z) ENDIF

  % Removing one copy of a and adding the elements of Y below a is one step.
  ms_ord_one_step : LEMMA
    FORALL (A, Y: finite_multiset, a: nat): A(a) > 0 IMPLIES
      ms_ord_one(A, union(difference(A, singleton_ms(a)), ms_below(Y, a)))

  ms_split_eq : LEMMA
    FORALL (X, A, Y: finite_multiset, a: nat): subset(X, A) AND X(a) > 0 IMPLIES
      union(difference(A, X), Y) =
        union(difference(union(difference(A, singleton_ms(a)), ms_below(Y, a)),
                         difference(X, singleton_ms(a))),
              ms_above(Y, a))

  ms_split_subset : LEMMA
    FORALL (X, A, Y: finite_multiset, a: nat): subset(X, A) AND X(a) > 0 IMPLIES
      subset(difference(X, singleton_ms(a)),
             union(difference(A, singleton_ms(a)), ms_below(Y, a)))

  ms_split_dom : LEMMA
    FORALL (X, Y: finite_multiset, a: nat):
      (FORALL y: member(y, Y) => EXISTS x: member(x, X) AND y < x) IMPLIES
      (FORALL y: member(y, ms_above(Y, a)) =>
         EXISTS x: member(x, difference(X, singleton_ms(a))) AND y < x)

  ms_split_dom_empty : LEMMA
    FORALL (X, Y: finite_multiset, a: nat):
      (FORALL y: member(y, Y) => EXISTS x: member(x, X) AND y < x) AND
      difference(X, singleton_ms(a)) = empty IMPLIES ms_above(Y, a) = empty

  % Generalisation of ms_ord_subset_ms_ord_one_tc, by induction on X.
  ms_ord_tc_aux : LEMMA
    FORALL (X, A, B, Y: finite_multiset):
      NOT X = empty AND subset(X, A) AND B = union(difference(A, X), Y) AND
      (FORALL y: member(y, Y) => EXISTS x: member(x, X) AND y < x)
      IMPLIES TC(ms_ord_one)(A, B)

  ms_ord_subset_ms_ord_one_tc : COROLLARY
    subset?(ms_ord,TC(ms_ord_one))

  ms_ord_equal_ms_ord_one_tc : COROLLARY
    ms_ord = TC(ms_ord_one)

  ms_ord_transitive : LEMMA
     transitive?(ms_ord)

  ms_ord_tc_equivalence: LEMMA
    subset?(TC(ms_ord_one), TC(ms_ord))

  ms_ord_one_subset_rtc: LEMMA
    subset?(RTC(ms_ord_one), RC(ms_ord))


  % max of a finite set of naturals, used in ms_ord_irreflexive
  IMPORTING finite_sets@finite_sets_minmax[nat, <=]

  ms_ord_irreflexive: LEMMA
    FORALL (m: finite_multiset):
      NOT ms_ord(m, m)


%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
% ITEM (B)
ms_ord_U_eq_poset: LEMMA partial_order?(RC(ms_ord)) 

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
%  ITEM (c)
  ms_ord_singleton_iff_lt: LEMMA
    x > y IFF ms_ord(singleton_ms(x), singleton_ms(y)) 

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
% ITEM (d)

 ms_ord_union_monotone : LEMMA
   FORALL(m,n,p:finite_multiset) :
     ms_ord(m,n) IMPLIES ms_ord(union(m,p), union(n,p))

  % If m exceeds n at a, and they agree on every element above a,
  % then m is above n in the multiset ordering (used in ms_ord_total_order)
  ms_ord_max_diff: LEMMA
    FORALL (m, n: finite_multiset, a: nat):
      m(a) > n(a) AND (FORALL y: y > a => m(y) = n(y)) IMPLIES ms_ord(m, n)

%% Lemma 7.3.11 [Ayala-Rincón and de Moura, 2014]
%% ITEM (e)
%% Indeed, this lemma, for a well-order geq over 
%% and non-interpreted type is an implication:
%% total_order?(geq) IMPLIES total_order?(ms_ord)
 ms_ord_total_order : LEMMA 
     total_order?(RC(ms_ord)) 
   

  ms_ord_empty: LEMMA
    FORALL (m: finite_multiset):
      NOT m = empty => ms_ord(m, empty)


  % Termination of the multiset ordering.
  % ms_ord(m, n) means that n is below m (ms_ord is a reduction relation),
  % so well-foundedness is stated for its converse: noetherian?(R) is
  % defined in TRS@noetherian as well_founded?(converse(R)).

  % Accessible part of ms_ord_one: M is accessible when all its one-step
  % successors are. Accessible elements start no infinite ms_ord_one chain.
  ms_acc(M: finite_multiset): INDUCTIVE bool =
    FORALL (N: finite_multiset): ms_ord_one(M, N) IMPLIES ms_acc(N)

  % If every finite multiset is accessible, ms_ord_one is noetherian.
  ms_acc_noetherian: LEMMA
    (FORALL (M: finite_multiset): ms_acc(M)) IMPLIES noetherian?(ms_ord_one)

  % Equations on multisets used in the accessibility proof
  ms_union_singl_diff: LEMMA
    FORALL (M, Y: finite_multiset, a: nat):
      union(difference(union(M, singleton_ms(a)), singleton_ms(a)), Y) = union(M, Y)

  ms_union_singl_diff_neq: LEMMA
    FORALL (M, Y: finite_multiset, a, b: nat): b /= a IMPLIES
      union(difference(union(M, singleton_ms(a)), singleton_ms(b)), Y) =
        union(union(difference(M, singleton_ms(b)), Y), singleton_ms(a))

  ms_union_split_one: LEMMA
    FORALL (M, Y: finite_multiset, b: nat): Y(b) > 0 IMPLIES
      union(M, Y) = union(union(M, difference(Y, singleton_ms(b))), singleton_ms(b))

  % Adding elements below a preserves accessibility, provided that adding
  % a single element below a does (induction on the occurrences of Y).
  ms_acc_add_below: LEMMA
    FORALL (a: nat):
      (FORALL (b: nat, M: finite_multiset):
         b < a AND ms_acc(M) IMPLIES ms_acc(union(M, singleton_ms(b))))
      IMPLIES
      FORALL (Y, M: finite_multiset):
        (FORALL y: member(y, Y) => y < a) AND ms_acc(M) IMPLIES ms_acc(union(M, Y))

  % Adding one element preserves accessibility (strong induction on a,
  % then induction on the accessibility of M).
  ms_acc_add: LEMMA
    FORALL (a: nat, M: finite_multiset):
      ms_acc(M) IMPLIES ms_acc(union(M, singleton_ms(a)))

  ms_acc_all: LEMMA
    FORALL (M: finite_multiset): ms_acc(M)

  ms_ord_one_noetherian: LEMMA
    noetherian?(ms_ord_one)

  % Uses ms_ord = TC(ms_ord_one) and the library lemma R_is_Noet_iff_TC_is
  ms_ord_noetherian: LEMMA
    noetherian?(ms_ord)

  ms_ord_well_founded: COROLLARY
    well_founded?[finite_multiset](converse(ms_ord))

END multisets_nat
